{
    "cron": "/cron",
    "font": "/fonts/sign.e6f",
    "default": "/text/default.txt",
    "rotation": 180,
    "battery_sleep": true,
    "wake_checkpoint_minutes": 360,
    "retry_minutes": 5,
    "low_battery_voltage": 3.1,
    "next": {
        "font": "/fonts/status.e6f",
        "long_press_ms": 3000,
        "status_seconds": 60,
        "preview_seconds": 60
    },
    "text": {
        "scale": 1,
        "margin": 24,
        "line_spacing": 8,
        "foreground": 0,
        "background": 1
    },
    "logging": {
        "level": "INFO",
        "directory": "/logs",
        "max_bytes": 65536,
        "backup_count": 3
    }
}
